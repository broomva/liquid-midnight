{
  "name": "liquid-midnight",
  "version": "0.1.0",
  "description": "Liquid Midnight style system: Apple Midnight grounds, liquid glass + liquid metal, WebGL glass plasma orbs, ASCII shaders, time-addressable motion.",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "exports": {
    "./kit": "./kit/index.js",
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./materials.css": "./css/materials.css"
  },
  "files": [
    "kit",
    "tokens",
    "css",
    "fonts",
    "DESIGN.md"
  ],
  "scripts": {
    "tokens": "bun scripts/build-tokens.mjs",
    "serve": "bun scripts/serve.mjs",
    "render": "bun scripts/render.mjs",
    "test": "bun test",
    "check": "bun scripts/build-tokens.mjs --check && biome check . && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "playwright": "1.62.0"
  }
}
